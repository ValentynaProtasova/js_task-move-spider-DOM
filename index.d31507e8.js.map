"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (!e.target.closest(".wall")) return;
    var wallRect = wall.getBoundingClientRect();
    var wallStyle = getComputedStyle(wall);
    var borderLeft = parseInt(wallStyle.borderLeftWidth);
    var borderTop = parseInt(wallStyle.borderTopWidth);
    var clickCoordinatX = e.clientX - wallRect.left - borderLeft;
    var clickCoordinatY = e.clientY - wallRect.top - borderTop;
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var leftPosit = clickCoordinatX - spiderWidth / 2;
    var topPosit = clickCoordinatY - spiderHeight / 2;
    var clampedLeft = Math.max(0, Math.min(leftPosit, wall.clientWidth - spiderWidth));
    var clampedTop = Math.max(0, Math.min(topPosit, wall.clientHeight - spiderHeight));
    spider.style.left = clampedLeft + "px";
    spider.style.top = clampedTop + "px";
});

